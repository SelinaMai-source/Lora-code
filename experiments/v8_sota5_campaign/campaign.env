# v8_sota5 paper campaign — source before launch scripts
#   source experiments/v8_sota5_campaign/campaign.env
#
# MANDATORY: All campaign runs MUST log to W&B project lora-citb-v8-sota5-paper.
# Do NOT set WANDB_MODE=disabled for this campaign. Always source this file first.

export WANDB_PROJECT="${WANDB_PROJECT:-lora-citb-v8-sota5-paper}"
: "${WANDB_PROJECT:?campaign.env: WANDB_PROJECT is required (default: lora-citb-v8-sota5-paper)}"
export WANDB_MODE="${WANDB_MODE:-online}"
export WANDB_ENTITY="${WANDB_ENTITY:-}"

# Seeds and benchmarks
export CAMPAIGN_SEEDS="${CAMPAIGN_SEEDS:-123,456,789}"
export CAMPAIGN_ABLATION_SEED="${CAMPAIGN_ABLATION_SEED:-123}"
export CAMPAIGN_ABLATION_BENCHMARKS="${CAMPAIGN_ABLATION_BENCHMARKS:-instrdialog,instrdialog++}"
export CAMPAIGN_PHASE1_BENCHMARK="${CAMPAIGN_PHASE1_BENCHMARK:-instrdialog++}"
export CAMPAIGN_PHASE1_SEED="${CAMPAIGN_PHASE1_SEED:-123}"

# Paths (relative to repo root)
export CAMPAIGN_BASE_CONFIG="${CAMPAIGN_BASE_CONFIG:-configs/paper/v8_sota_5.yaml}"
export CAMPAIGN_CONFIG_DIR="${CAMPAIGN_CONFIG_DIR:-configs/paper/v8_sota5_campaign}"
export CAMPAIGN_MANIFEST="${CAMPAIGN_MANIFEST:-experiments/v8_sota5_campaign/manifest.csv}"

# Run-name suffix to avoid colliding with legacy lora-citb-sota runs
export CAMPAIGN_RUN_SUFFIX="${CAMPAIGN_RUN_SUFFIX:-v8s5camp}"

# W&B group names
export WANDB_GROUP_PHASE1="${WANDB_GROUP_PHASE1:-phase1_priority_instrdialogpp}"
export WANDB_GROUP_ABLATION="${WANDB_GROUP_ABLATION:-ablation_single_seed}"
export WANDB_GROUP_OURS_INSTRDIALOG="${WANDB_GROUP_OURS_INSTRDIALOG:-ours_multiseed_instrdialog}"
export WANDB_GROUP_OURS_INSTRDIALOGPP="${WANDB_GROUP_OURS_INSTRDIALOGPP:-ours_multiseed_instrdialogpp}"
export WANDB_GROUP_BASELINE_INSTRDIALOG="${WANDB_GROUP_BASELINE_INSTRDIALOG:-baseline_multiseed_instrdialog}"
export WANDB_GROUP_BASELINE_INSTRDIALOGPP="${WANDB_GROUP_BASELINE_INSTRDIALOGPP:-baseline_multiseed_instrdialogpp}"

# Baseline variant IDs (Category C — excludes replay_b10)
export CAMPAIGN_BASELINE_VARIANTS="${CAMPAIGN_BASELINE_VARIANTS:-seq,replay_b50,periodic_latest,bank_no_router,router_only}"

export CUDA_VISIBLE_DEVICES="${CUDA_VISIBLE_DEVICES:-0}"
export PYTORCH_CUDA_ALLOC_CONF="${PYTORCH_CUDA_ALLOC_CONF:-expandable_segments:True}"
